# =============================================================================
# OSG — Obsidian Site Generator
# Full configuration reference. Every key shown here can also be set via
# environment variables with the OSG_ prefix (e.g. OSG_SITE_TITLE).
# For nested keys use double underscores (e.g. OSG_AI__PROVIDER=gemini).
#
# Copy this file as config.yaml and adjust to your needs:
#   cp config.yaml.example config.yaml
# =============================================================================

# -----------------------------------------------------------------------------
# Site identity
# -----------------------------------------------------------------------------
# site_title: Displayed in the header, browser tab, and meta tags.
# site_description: Used in the HTML <meta name="description"> and OpenGraph.
# base_url: Absolute URL of the deployed site (e.g. "https://blog.example.com").
#           Leave empty for local/relative links.
# default_language: BCP-47 language code (e.g. "es", "en", "fr") used as the
#                   default for template translations and date localisation.
#                   Each page can override this via the "lang" front-matter field.
site_title: "OSG"
site_description: ""
base_url: ""
default_language: es

# -----------------------------------------------------------------------------
# Content
# -----------------------------------------------------------------------------
# vault_path: Path to the Obsidian vault to import from (used by "osg import").
# content_dir: Directory where Markdown content lives.
# content_layout: URL pattern for pages. Placeholders: {date}, {slug}, {title}.
# include_drafts: Render pages with "draft: true" in front-matter.
vault_path: ""
content_dir: content
content_layout: "{date}/{slug}"
include_drafts: false

# -----------------------------------------------------------------------------
# New Post (osg new)
# -----------------------------------------------------------------------------
# default_editor: Editor command to open new posts after creation with "osg new".
#                 Supports commands with arguments (e.g. "code --wait").
#                 If empty, falls back to the $EDITOR environment variable.
#                 If neither is set, editor auto-open is silently skipped.
#                 Use --no-editor to skip opening regardless.
# default_editor: "code --wait"
#
# new_notes_dir: Subdirectory within the vault where "osg new" creates notes.
#                Relative to vault_path. If empty, notes are created at the
#                vault root (Obsidian default). The directory is auto-created
#                if it does not exist. Override per-call with --notes-dir.
# new_notes_dir: "02_Notes"

# -----------------------------------------------------------------------------
# Theme & appearance
# -----------------------------------------------------------------------------
# theme: Active theme name (must match a subdirectory of themes_dir).
# themes_dir: Directory that contains installed themes.
# color_scheme: Color scheme for the default theme.
#   "auto"  — follows the visitor's OS preference (prefers-color-scheme).
#   "light" — always light mode.
#   "dark"  — always dark mode.
theme: default
themes_dir: themes
color_scheme: auto
# logo: Path or URL to a logo image shown in the header next to the site title.
#       Supported formats: SVG, PNG, WebP. Recommended size: ~36px square.
#       When empty, a default geometric icon is displayed.
# logo: "/images/logo.svg"

# -----------------------------------------------------------------------------
# Navigation
# -----------------------------------------------------------------------------
# nav_taxonomy: Name of the taxonomy whose terms should appear as links in
#               the header navigation bar (e.g. "area", "tags").
#               When empty (default), the header shows taxonomy index links
#               (the taxonomy names themselves) instead of individual terms.
nav_taxonomy: ""

# -----------------------------------------------------------------------------
# Output
# -----------------------------------------------------------------------------
# public_dir: Directory where the generated site is written.
# clean_public: Remove public_dir before a full build.
public_dir: public
clean_public: true

# -----------------------------------------------------------------------------
# Summaries
# -----------------------------------------------------------------------------
# summary_strategy: How to generate page summaries for listings and feeds.
#   "auto"   — (default) extract first sentences from the markdown body when
#              the page has no summary/description/excerpt in front-matter.
#   "manual" — only use summaries written explicitly in front-matter.
#   "ai"     — generate summaries via LLM using Kairos (see "ai" section
#              below). If the AI provider cannot be created (e.g. missing API
#              key), falls back to "auto" automatically with a warning.
summary_strategy: auto

# -----------------------------------------------------------------------------
# AI summary generation (Kairos)
# -----------------------------------------------------------------------------
# Only used when summary_strategy is "ai".
#
# ai.provider: LLM provider to use. Supported values:
#   "gemini"    — Google Gemini (default)
#   "anthropic" — Anthropic Claude
#   "openai"    — OpenAI
#   "qwen"      — Alibaba Qwen (DashScope)
#   "ollama"    — Local Ollama instance
#
# ai.model: Model identifier. If empty, the provider's default is used:
#   gemini    -> gemini-3-flash-preview
#   anthropic -> claude-haiku-4-20250514
#   openai    -> gpt-5-mini
#   qwen      -> qwen-turbo
#   ollama    -> (must be set explicitly, e.g. "llama3.2")
#
# ai.api_key: API key for the provider. RECOMMENDED: use an environment
#   variable instead of putting the key here (avoids committing secrets).
#   If left empty, the provider looks for its native env var:
#     gemini    -> GOOGLE_API_KEY  or  GEMINI_API_KEY
#     anthropic -> ANTHROPIC_API_KEY
#     openai    -> OPENAI_API_KEY
#     qwen      -> (no default env var — api_key is required)
#     ollama    -> (not needed)
#   You can also use the OSG env var: OSG_AI__API_KEY=your-key
#
# ai.base_url: Override the API endpoint. Mainly useful for:
#   - ollama: "http://localhost:11434" (default if omitted)
#   - OpenAI-compatible proxies or self-hosted endpoints
#
# ai.system_prompt: Custom system instruction sent to the LLM.
#   Default: "Summarize the following blog post in 2-3 concise sentences
#   for use as a preview excerpt."
#
# ai.timeout: Per-request timeout in seconds (default: 30).
#
# ai.concurrency: Maximum number of parallel LLM requests (default: 3).
#   Higher values speed up builds with many pages but increase API load.
ai:
  provider: gemini
  model: "gemini-3-flash-preview"
  # api_key: ""        # Prefer env var: export GOOGLE_API_KEY=your-key
  # base_url: ""
  # system_prompt: ""
  timeout: 30
  concurrency: 3

# -----------------------------------------------------------------------------
# Site feed
# -----------------------------------------------------------------------------
# site_feed: Generate a site-wide RSS and Atom feed at the root (/atom.xml,
#            /rss.xml) containing the most recent pages across all sections.
# site_feed_limit: Maximum number of entries in the site feed (0 = all pages).
site_feed: true
site_feed_limit: 20

# -----------------------------------------------------------------------------
# Templates & static assets
# -----------------------------------------------------------------------------
# templates_dir: User-level template overrides (merged on top of the theme).
# static_dir: Extra static files copied as-is to public_dir.
templates_dir: templates
static_dir: static

# -----------------------------------------------------------------------------
# Plugins
# -----------------------------------------------------------------------------
# plugins_dir: Directory containing .wasm plugin files.
# plugins_enabled: List of plugin names to activate (without .wasm extension).
#   The "search" plugin is bundled and enabled by default if plugins_enabled
#   is not set. Set to [] to disable all plugins.
# plugin_timeout: Per-plugin call timeout in seconds (0 = no timeout).
plugins_dir: plugins
plugins_enabled:
  - search
plugin_timeout: 5

# -----------------------------------------------------------------------------
# Sass
# -----------------------------------------------------------------------------
# sass_dir: Directory with .scss files to compile.
# compile_sass: Enable Sass compilation.
sass_dir: sass
compile_sass: false

# -----------------------------------------------------------------------------
# Build
# -----------------------------------------------------------------------------
# build_incremental: Only re-render changed pages (speeds up rebuilds).
# build_cache_dir: Where build cache data is stored.
build_incremental: true
build_cache_dir: .osg/cache

# -----------------------------------------------------------------------------
# Sharing
# -----------------------------------------------------------------------------
# sharing: Enable social sharing buttons (X, LinkedIn, Bluesky, Email, Copy link)
#          and a copy-link icon next to the article title. Appears on article
#          pages only. The share section resolves absolute URLs from base_url.
sharing: true

# -----------------------------------------------------------------------------
# Image lightbox
# -----------------------------------------------------------------------------
# lightbox: Enable click-to-zoom lightbox for content images. Standalone images
#           in Markdown are wrapped in <figure data-lightbox> and a zero-dependency
#           JS lightbox handles fullscreen overlay, keyboard/touch navigation,
#           auto gallery grouping for consecutive images, and captions from alt text.
lightbox: true

# -----------------------------------------------------------------------------
# Minification
# -----------------------------------------------------------------------------
# minify: Minify HTML, CSS, JS, JSON, SVG, and XML files in public/ after
#         rendering. Uses tdewolff/minify for fast, standards-compliant output.
#         Disable for easier debugging of generated output.
minify: true

# -----------------------------------------------------------------------------
# Image optimization
# -----------------------------------------------------------------------------
# image_optimization: Generate responsive image variants (resized JPEG + WebP + AVIF).
#   When enabled, raster images (jpg, jpeg, png, webp, avif) in public/ are
#   processed after asset copy: resized to each configured width and converted
#   to WebP (via cwebp) and AVIF (via avifenc) when those binaries are available.
#   Templates emit <picture> elements with srcset in priority order: AVIF > WebP > JPEG.
# image_quality: Encoding quality for JPEG, WebP and AVIF variants (1-100).
# image_widths: List of pixel widths to generate (images smaller than a width
#               are skipped — no upscaling).  The original is always kept.
image_optimization: true
image_quality: 80
image_widths: [640, 1200]

# -----------------------------------------------------------------------------
# Breadcrumbs
# -----------------------------------------------------------------------------
# breadcrumbs: Show breadcrumb navigation (Home / Section / Title) at the top
#              of article pages. Useful for section-based URL structures.
#              For date-based layouts ({date}/{slug}) the intermediate path
#              segments may not be meaningful — set to false to disable.
breadcrumbs: true

# -----------------------------------------------------------------------------
# Math (KaTeX)
# -----------------------------------------------------------------------------
# math: Enable math/LaTeX rendering via KaTeX. When enabled, inline math
#       ($...$) and display math ($$...$$) in Markdown content are rendered
#       as formatted equations. KaTeX CSS and JS are loaded from CDN.
math: false

# -----------------------------------------------------------------------------
# Dev server (osg serve)
# -----------------------------------------------------------------------------
# serve_watch: Watch files for changes and rebuild automatically.
# serve_live_reload: Inject live-reload script into served pages.
# serve_debounce_ms: Milliseconds to wait before triggering a rebuild after
#                    a file change (avoids rapid successive builds).
serve_watch: true
serve_live_reload: true
serve_debounce_ms: 300

# -----------------------------------------------------------------------------
# Interactions (views, likes/dislikes)
# -----------------------------------------------------------------------------
# Enable page view counting and like/dislike buttons at the bottom of posts.
# Requires running the interactions API (standalone via "osg api" or embedded
# in the dev server via "osg serve --api").
#
# interactions:
#   enabled: true
#   api_url: ""              # Browser-visible API URL. Empty = same origin.
#                            # For production set full URL (e.g. "https://api.mysite.com").
#   listen: ":8090"          # Address for standalone "osg api" server.
#   db_path: ".osg/interactions.db"  # SQLite database file path.
#   cors_origins:            # Allowed CORS origins (only needed for cross-origin API).
#     - "https://mysite.com"
#   view_dedup_hours: 24     # Dedup window: same fingerprint counts as one
#                            # unique view per page within this period.
#
# --- Comments (nested under interactions) ---
# OAuth2-authenticated comment system with threaded replies.
# Uses a separate SQLite database for future portability.
#
# Visitors log in with their own GitHub/Google account to comment.
# The client_id and client_secret below identify YOUR SITE (not the
# commenter) to the OAuth provider. You obtain them by registering an
# OAuth application:
#
#   GitHub:
#     1. Go to https://github.com/settings/developers -> "OAuth Apps" -> "New OAuth App"
#     2. Set "Authorization callback URL" to:
#        https://yoursite.com/api/v1/auth/github/callback
#     3. Copy the Client ID and Client Secret into the config below.
#
#   Google:
#     1. Go to https://console.cloud.google.com/apis/credentials
#     2. Create an "OAuth 2.0 Client ID" (Web application).
#     3. Add to "Authorized redirect URIs":
#        https://yoursite.com/api/v1/auth/google/callback
#     4. Copy the Client ID and Client Secret into the config below.
#
# When a visitor clicks "Login with GitHub", they are redirected to
# GitHub where they authorize your app. GitHub sends back a temporary
# code that the server exchanges (using the client_secret) for the
# visitor's public profile. The visitor's password never touches your
# site.
#
#   comments:
#     enabled: true
#     db_path: ".osg/comments.db"     # Separate DB for comments.
#     auth_session_days: 30            # Login session lifetime in days.
#     auth_callback_url: ""            # Base URL for OAuth callbacks.
#                                      # Must match the callback URL registered
#                                      # with the provider (without the path).
#                                      # E.g. "https://yoursite.com"
#     providers:                       # OAuth2 providers for login.
#       - provider: github
#         client_id: "your_github_client_id"
#         client_secret: "your_github_client_secret"
#       - provider: google
#         client_id: "your_google_client_id"
#         client_secret: "your_google_client_secret"

# -----------------------------------------------------------------------------
# Deployment (osg deploy)
# -----------------------------------------------------------------------------
# Deploy the generated site to a remote destination.
#
# deploy.provider: Deployment target. Supported values:
#   "cloudflare" — Cloudflare Pages or Workers (requires wrangler CLI)
#   "rsync"      — rsync over SSH (any VPS or server)
#   "s3"         — AWS S3 or compatible (Cloudflare R2, Backblaze B2)
#
# Usage:
#   osg deploy                  # uses deploy.provider from config
#   osg deploy --provider rsync # override provider
#   osg deploy --preview        # dry-run (validate config only)
#   osg deploy --build=false    # skip build step
#
# All providers support environment variables via OSG_DEPLOY__ prefix.

# deploy:
#   provider: cloudflare
#
#   # Cloudflare Workers Static Assets (recommended for static sites)
#   cloudflare:
#     worker_name: "my-blog"       # Worker name in Cloudflare (required)
#     not_found_handling: "404-page"  # "none", "single-page-application", or "404-page"
#     compatibility_date: "2024-09-01"  # Worker runtime version
#     account_id: ""               # Optional, for multi-account
#     # CLOUDFLARE_API_TOKEN env var required
#
#   # rsync over SSH (any VPS/server)
#   rsync:
#     host: "user@example.com"     # SSH destination (required)
#     path: "/var/www/blog"        # Remote path (required)
#     port: "22"                   # SSH port (default: 22)
#     key_file: "~/.ssh/id_ed25519"  # SSH private key
#     delete: true                 # Remove stale remote files
#     exclude: ".osg,*.tmp"        # Comma-separated exclude patterns
#     extra_flags: ""              # Additional rsync flags
#
#   # S3-compatible storage (AWS S3, Cloudflare R2, Backblaze B2)
#   s3:
#     bucket: "my-bucket"          # Bucket name (required)
#     region: "eu-west-1"          # AWS region
#     endpoint: ""                 # Custom endpoint for R2/B2
#     path: "blog"                 # Optional prefix
#     delete: false                # Sync deletions (careful!)
#     acl: "public-read"           # Object ACL
#     profile: ""                  # AWS profile (or AWS_PROFILE env)
#     extra_flags: ""              # Additional aws s3 flags
#     # AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY env vars required
#     # Optional: CLOUDFRONT_DISTRIBUTION_ID to invalidate CDN cache

# -----------------------------------------------------------------------------
# TUI
# -----------------------------------------------------------------------------
# tui_prefix: Key used as prefix in the interactive TUI ("space" or "ctrl").
# tui_prefix_ms: Milliseconds to wait for a second key after prefix.
# tui_log_modifier: Modifier key for log panel navigation ("shift" or "alt").
#   "shift" (default) — works on all platforms and terminals.
#   "alt"   — use only if your terminal sends Option/Alt as Meta (Esc+).
#             On macOS, Option does NOT work as Meta by default.
#             To enable it: iTerm2 → Profiles → Keys → Left/Right Option → Esc+
#             or Terminal.app → Preferences → Profiles → Keyboard →
#             "Use Option as Meta key".
tui_prefix: space
tui_prefix_ms: 600
tui_log_modifier: shift

# -----------------------------------------------------------------------------
# Diagnostics
# -----------------------------------------------------------------------------
# doctor_profile: Profile for "osg doctor" checks ("dev" or "prod").
doctor_profile: dev

# -----------------------------------------------------------------------------
# Author bio card
# -----------------------------------------------------------------------------
# Displayed at the bottom of every article page. Both fields are optional;
# the card is hidden when neither is set.
#
# author_bio: Short bio text shown next to the avatar.
# author_avatar: Path or URL to a square photo/avatar (recommended: 144px+).
# author_bio: "Developer and writer. I build things with Go and write about it."
# author_avatar: "/images/avatar.jpg"

# -----------------------------------------------------------------------------
# Social links, copyright & license
# -----------------------------------------------------------------------------
# social: Map of social network handles shown as icons in the footer.
#   Only configured networks appear. Supported keys:
#   x, github, mastodon, linkedin, bluesky, email
#   For email use the address directly (mailto: is added automatically).
# copyright: Copyright notice shown in the footer bar.
#   Use {year} as a placeholder for the current year.
#   If empty, defaults to "(c) {year} {site_title}".
# social:
#   x: "https://x.com/your_handle"
#   github: "https://github.com/your_user"
#   mastodon: "https://mastodon.social/@your_handle"
#   linkedin: "https://linkedin.com/in/your_profile"
#   bluesky: "https://bsky.app/profile/your_handle"
#   email: "you@example.com"
# copyright: ""
#
# license: Site content license displayed in the footer.
#   Supports markdown links: [text](url) for linking to the full license.
#   Leave empty to hide.
# license: "CC [BY-NC-ND 4.0](https://creativecommons.org/licenses/by-nc-nd/4.0/)"

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
# level: Minimum log level (debug, info, warn, error).
# format: Log output format ("json" or "text").
logging:
  level: info
  format: json

# -----------------------------------------------------------------------------
# Section feeds & pagination
# -----------------------------------------------------------------------------
# section_feeds: Generate per-section RSS and Atom feeds (e.g. /blog/atom.xml).
# posts_per_page: Number of posts per page on the homepage (0 = no pagination).
section_feeds: true
posts_per_page: 10

# -----------------------------------------------------------------------------
# Webhooks
# -----------------------------------------------------------------------------
# Receive HTTP POST notifications on build and deploy events.
# Each webhook specifies a URL, an optional list of events to subscribe to,
# and an optional HMAC-SHA256 secret for verifying payloads.
#
# Events:
#   build.success  — build completed without errors
#   build.failure  — build completed with errors
#   deploy.success — deploy completed successfully
#
# If "events" is empty or omitted, the webhook receives ALL events.
# The request body is JSON with the event payload (build stats, etc.).
# If "secret" is set, an X-OSG-Signature header is sent with the request:
#   X-OSG-Signature: sha256=<hex-encoded HMAC-SHA256 of the body>
#
# webhooks:
#   - url: "https://hooks.example.com/osg"
#     events: ["build.success", "deploy.success"]
#     secret: "my-webhook-secret"
#   - url: "https://slack.example.com/webhook"
#     events: []            # empty = all events

# -----------------------------------------------------------------------------
# Analytics
# -----------------------------------------------------------------------------
# analytics: Enable lightweight first-party analytics (no third-party scripts).
#   When enabled and the API server is running (osg serve --api or osg api),
#   OSG tracks pageviews, referrer domains, and browser families in the same
#   SQLite database used by interactions.
#
#   A tracking script is generated at /js/analytics.js — add it to your
#   templates or use the build helper GenerateAnalyticsScript().
#
#   Respects the DNT (Do Not Track) header: both the JS script and the API
#   endpoint skip tracking when DNT=1.
#
#   API endpoints (when analytics is enabled):
#     POST /api/v1/analytics/hit     — record a pageview
#     GET  /api/v1/analytics/summary — aggregated data (top pages, referrers,
#                                      daily views, browser breakdown)
#
#   Default: false (disabled).
# analytics: true
analytics: false

# -----------------------------------------------------------------------------
# Third-party analytics providers
# -----------------------------------------------------------------------------
# Inject tracking scripts from well-known analytics services.
# Each provider generates the appropriate <script> tag automatically,
# injected before </body> as recommended by most providers.
# You can configure multiple providers at the same time.
#
# Supported providers:
#   cloudflare — Cloudflare Web Analytics (requires "token")
#   google     — Google Analytics GA4 (requires "tracking_id", e.g. "G-XXXXXXX")
#   plausible  — Plausible Analytics (requires "domain")
#   fathom     — Fathom Analytics (requires "token", your Site ID)
#
# analytics_providers:
#   - provider: cloudflare
#     token: "your-cloudflare-token"
#   - provider: google
#     tracking_id: "G-XXXXXXX"
#   - provider: plausible
#     domain: "example.com"
#   - provider: fathom
#     token: "ABCDEF"

# -----------------------------------------------------------------------------
# Custom code injection
# -----------------------------------------------------------------------------
# Inject arbitrary HTML/JS into every page. Useful for verification meta tags,
# custom scripts, or analytics providers not covered by analytics_providers.
#
# head_extra: Injected at the end of <head> (meta tags, preloads, etc.).
# body_extra: Injected just before </body> (after analytics provider scripts).
#
# head_extra: '<meta name="google-site-verification" content="abc123" />'
# body_extra: '<script src="/js/custom.js"></script>'

# -----------------------------------------------------------------------------
# Taxonomies
# -----------------------------------------------------------------------------
# Define content groupings derived from front-matter fields.
# Each taxonomy generates listing pages and per-term pages.
#
# taxonomies:
#   - name: tags            # front-matter field name
#     paginate_by: 10       # items per page (0 = no pagination)
#     paginate_path: page   # URL segment for paginated pages
#     feed: true            # generate RSS/Atom feed for this taxonomy
#     render: true          # generate HTML pages
#   - name: area
#     paginate_by: 10
#     paginate_path: page
#     feed: false
#     render: true

# =============================================================================
# Content front-matter fields reference
# =============================================================================
# These fields are set in the YAML front-matter of individual Markdown pages,
# NOT in this config file. They are listed here for reference.
#
# --- Standard fields ---
# title:        Page title (string)
# date:         Publication date (YYYY-MM-DD)
# draft:        true to mark as unpublished (boolean)
# summary:      Manual summary/excerpt (string)
# description:  Alias for summary (string)
# tags:         List of tags ([]string)
# image:        Hero/OG image path (string)
# image_credit: Attribution text shown as <figcaption> under the hero (string)
# lang:         Override default_language for this page (string, BCP-47)
# slug:         Override the URL slug derived from filename (string)
# toc:          Show table of contents sidebar (boolean, default: false)
# menu:         Include page in main navigation (boolean)
#
# --- Series ---
# series:       Name of the article series this page belongs to (string).
#               Pages with the same series name are grouped into a numbered
#               navigation widget showing all parts, with prev/next links.
# series_order: Explicit position within the series (integer, 1-based).
#               When omitted or 0, pages are sorted by date within the series.
#
# --- Footnotes / Sidenotes ---
# Standard Markdown footnotes [^1] are automatically converted to Tufte-style
# sidenotes in the right margin on wide screens (≥1200px) when the page does
# NOT have a TOC sidebar. No front-matter field needed.
#
# --- Backlinks ---
# Backlinks are detected automatically from internal links across all pages.
# No front-matter field needed. A "Backlinks" section appears at the bottom
# of any page that is linked to by other pages.
